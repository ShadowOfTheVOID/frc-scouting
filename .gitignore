# Every API key, the admin password, and on a mirror host its two secrets.
# `.env.example` is the committed one; this is the filled-in copy and it never
# goes near git. It is also the one file worth backing up somewhere private.
.env

# Runtime state — never commit. Holds the event database: the scouting, the
# strategy passcode hash and unlock tokens. The API keys are not in here; they
# live in .env, which is what keeps them out of every snapshot.
data/

# The mirror's own database, on whatever host it runs on. Same reasoning: it
# holds a whole event's scouting and the tokens people unlocked it with.
mirror/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local scratch
*.log
/tmp/
