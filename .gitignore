# Runtime state — never commit. Holds the event database, which contains the
# strategy passcode hash, unlock tokens, and any API keys the hub was given.
data/

# The mirror's own database, on whatever host it runs on. Same reasoning: it
# holds a whole event's scouting and the tokens people unlocked it with.
mirror/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local scratch
*.log
/tmp/
